# ---- copy this file to ".env" and fill in the values. NEVER commit .env ----
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Long random secrets (32+ chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
OTP_SECRET=

# Only these email domains can log in (subdomains such as student.nitte.edu.in also work)
ALLOWED_EMAIL_DOMAINS=nmamit.in,nitte.edu.in

# Faculty coordinators who may approve/reject bookings (comma separated, college emails)
COORDINATOR_EMAILS=coordinator@nmamit.in

# Excel data file (relative to the backend folder). Created automatically.
EXCEL_PATH=data/campusconnect.xlsx

# ---- Email (SMTP) used to send the real OTP ----
# MAIL_MODE=smtp sends real emails. MAIL_MODE=console only prints the mail in the terminal
# (local testing only - it is refused when NODE_ENV=production).
MAIL_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.sender@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="CampusConnect <your.sender@gmail.com>"
